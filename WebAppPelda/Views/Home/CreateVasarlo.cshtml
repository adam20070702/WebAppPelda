@model WebAppPelda.Models.Customer

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Vásárló adatai</h2>

    @if (TempData["Success message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <form asp-controller="Home" asp-action="CreateVasarlo" method="post" class="needs-validation" novalidate>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Név:</label>
            <input asp-for="Name" class="form-control" placeholder="Minta János"/>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Telefon:</label>
            <input asp-for="Phone" class="form-control" placeholder="+36 1 123 4567" />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email:</label>
            <input asp-for="Email" class="form-control" placeholder="mintajanos@example.com" />
        </div>

        <div class="mb-3">
            <label asp-for="Score" class="form-label">Pontszám:</label>
            <input asp-for="Score" type="number" class="form-control" placeholder="123" />
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label">Cím:</label>
            <input asp-for="Address" class="form-control" placeholder="Budapest, XXX utca 12." />
        </div>
         
		<button type="submit" class="btn btn-primary w-100" >Mentés</button>
    </form>
</div>